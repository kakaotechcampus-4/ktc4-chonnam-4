# deploy/compose.dev.yml 이 읽는 값의 목록. 로컬에서 손으로 띄울 때 참고한다.
# 서버의 .env 는 deploy/host/deploy.sh 가 Parameter Store(/neuringo/<환경>/…)에서 만든다. 목록은 deploy/host/params.txt.
# 공개 레포라 계정·비밀번호는 여기에 적지 않는다.

APP_IMAGE=<계정>.dkr.ecr.ap-northeast-2.amazonaws.com/neuringo/backend:<커밋 SHA>
WEB_IMAGE=<계정>.dkr.ecr.ap-northeast-2.amazonaws.com/neuringo/backend:web-<커밋 SHA>
DB_NAME=neuringo_dev
DB_USERNAME=
DB_PASSWORD=

# 필요할 때만 바꾼다.
# SPRING_PROFILES_ACTIVE=dev
# APP_BIND=127.0.0.1
# APP_PORT=8080          # 화면(web) 이 여는 포트. backend 는 호스트에 열지 않는다
# DB_URL=jdbc:postgresql://postgres:5432/neuringo_dev   # 없으면 같은 서버의 postgres 컨테이너
# BACKEND_MEM_LIMIT=1536m
# WEB_MEM_LIMIT=64m
# PR 미리보기만(deploy.sh MODE=preview 가 넣는다): APP_DB_URL·APP_DB_USERNAME·APP_DB_PASSWORD
# POSTGRES_MEM_LIMIT=768m
