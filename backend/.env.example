# 이 파일을 .env 로 복사해서 쓰세요 — .env 는 커밋되지 않습니다.
#
#   cp backend/.env.example backend/.env
#
# 로컬 DB 는 컨테이너 안에서만 쓰고 지워지므로 계정·비번은 아무 값이나
# 본인이 정해서 넣으면 됩니다. 값을 여기(.env.example)에 적지는 마세요.
#
# ⚠️ 이 파일은 docker compose(compose.yml)만 읽습니다. Spring Boot 는 .env 를 읽지 않습니다.
#    local 프로필로 앱을 띄우려면 아래 SPRING_PROFILES_ACTIVE·DB_* 를 환경변수(IDE 실행 설정 등)로
#    같은 값으로 넘겨주세요. 자세한 절차는 backend/README.md 의 3번 항목.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_NAME=neuringo_local
DB_URL=jdbc:postgresql://localhost:5432/neuringo_local
DB_USERNAME=
DB_PASSWORD=

DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

TZ=Asia/Seoul
