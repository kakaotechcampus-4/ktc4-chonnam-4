# 이 파일을 .env 로 복사해서 쓰세요 — .env 는 커밋되지 않습니다.
#
#   cp backend/.env.example backend/.env
#
# DB_NAME / DB_USERNAME / DB_PASSWORD 는 compose.yaml 의 Postgres 컨테이너와
# Spring 의 local 프로파일이 함께 읽습니다. 셋 다 채워야 로컬이 뜹니다.
#
# 로컬 DB 는 컨테이너 안에서만 쓰고 지워지므로 계정·비번은 아무 값이나
# 본인이 정해서 넣으면 됩니다. 값을 여기(.env.example)에 적지는 마세요.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_NAME=neuringo_local
DB_URL=jdbc:postgresql://localhost:5432/neuringo_local
DB_USERNAME=
DB_PASSWORD=

DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

TZ=Asia/Seoul
